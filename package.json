{
  "name": "random-isekai",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5288",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 5289",
    "test": "vitest run",
    "start": "node server/server.mjs",
    "dev:server": "node server/server.mjs",
    "cf:migrate:local": "wrangler d1 migrations apply random-isekai-memorial --local",
    "cf:dev": "npm run build && npm run cf:migrate:local && wrangler pages dev --port 8788"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3",
    "wrangler": "^4.149.0"
  }
}
